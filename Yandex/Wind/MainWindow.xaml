<Window x:Class="Yandex.Wind.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        
     xmlns:ScottPlot="http://schemas.scottplot.net/2008/xaml/presentation"
       
        xmlns:local="clr-namespace:Yandex.Wind"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="800" Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <Menu x:Name="Mn">
            <MenuItem Header="Настройки" Click="MenuItem_Click"/>
        </Menu>
        <Frame x:Name="Fr" Grid.Row="1" NavigationUIVisibility="Hidden" />
    </Grid>
</Window>