<Window x:Class="Yandex.Wind.Options"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Yandex.Wind"
        mc:Ignorable="d"
        Title="Options" Height="700" Width="1000" ResizeMode="CanMinimize" FontSize="20" Background="Black" Loaded="Window_Loaded">
    <Grid>
        <TabControl x:Name="tab">
            <TabItem Header="Настройки пользователя">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="70" MaxHeight="70"/>
                        <RowDefinition Height="100"  MaxHeight="100"/>
                        <RowDefinition Height="80" MaxHeight="100"/>
                    </Grid.RowDefinitions>
                    <Label Content="Токен Яндекс" Grid.Row="0" Grid.Column="0" Margin="10,10,10,0"  VerticalAlignment="Bottom"  />
                    <TextBox  Padding="17" x:Name="tbTokenYandex" TextWrapping="Wrap" Grid.Row="1" Grid.Column="0" Margin="10"   />
                    <Label Content="Токен Adprofex" Grid.Row="0" Grid.Column="1" Margin="10,10,10,0"  VerticalAlignment="Bottom"/>
                    <TextBox Padding="17" x:Name="tbTokenAdprofex" TextWrapping="Wrap" Grid.Row="1" Grid.Column="1" Margin="10"   />
                    <Label Content="Логин Adprofex" Grid.Row="0" Grid.Column="2" Margin="10,10,10,0"  VerticalAlignment="Bottom"/>
                    <TextBox Padding="17" x:Name="tbLogAdprofex" TextWrapping="Wrap" Grid.Row="1" Grid.Column="2" Margin="10"   />
                    <Label Content="Пароль Adprofex" Grid.Row="0" Grid.Column="3" Margin="10,10,10,0"  VerticalAlignment="Bottom" />
                    <TextBox Padding="17" x:Name="tbPasswordAdprofex" TextWrapping="Wrap" Grid.Row="1" Grid.Column="3" Margin="10"   />
                    <Button Content="Сохранить" Grid.Row="2" Grid.Column="4" Margin="10" Click="btnUserSaveClick"/>
                </Grid>
            </TabItem>
            <TabItem Header="Настройки стран">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>

                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="0.5*"/>
                    </Grid.RowDefinitions>
                    <ListBox x:Name="lbCountryOptyons" Margin="10" Grid.RowSpan="3" SelectionChanged="lbSrlectCountryOptions"/>
                    <GroupBox Header="Настройки" FontSize="20" Margin="10" Grid.Column="1" Grid.RowSpan="3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>

                            </Grid.RowDefinitions>
                            <Label Content="Название" Grid.Row="0" VerticalAlignment="Bottom" Grid.Column="1" Margin="10,0,10,0"/>
                            <TextBox x:Name="tbCountryOptionsName" Grid.Row="1" Grid.Column="1"  Margin="10,0,10,20"/>

                            <Label Content="Время" Grid.Row="2" VerticalAlignment="Bottom" Grid.Column="0" Margin="10,0,10,0"/>
                            <TextBox x:Name="tbCountryOptionsTime" Grid.Row="3" Grid.Column="0"  Margin="10,0,10,20"/>

                            <Label Content="Увеличение" Grid.Row="2" VerticalAlignment="Bottom" Grid.Column="1" Margin="10,0,10,0"/>
                            <TextBox x:Name="tbCountryOptionsUp" Grid.Row="3" Grid.Column="1"  Margin="10,0,10,20"/>

                            <Label Content="Уменьшение" Grid.Row="2" VerticalAlignment="Bottom" Grid.Column="2" Margin="10,0,10,0"/>
                            <TextBox x:Name="tbCountryOptionsDown" Grid.Row="3" Grid.Column="2"  Margin="10,0,10,20"/>

                            <Label Content="Проц. дохода" Grid.Row="4" VerticalAlignment="Bottom" Grid.Column="0" Margin="10,0,10,0"/>
                            <TextBox x:Name="tbCountryOptionsProc" Grid.Row="5" Grid.Column="0"  Margin="10,0,10,20"/>

                            <Label Content="Мин. Нули" Grid.Row="4" VerticalAlignment="Bottom" Grid.Column="1" Margin="10,0,10,0"/>
                            <TextBox x:Name="tbCountryOptionsMin" Grid.Row="5" Grid.Column="1"  Margin="10,0,10,20"/>

                            <Label Content="Макс. Нули" Grid.Row="4" VerticalAlignment="Bottom" Grid.Column="2" Margin="10,0,10,0"/>
                            <TextBox x:Name="tbCountryOptionsMax" Grid.Row="5" Grid.Column="2"  Margin="10,0,10,20"/>

                            <Label Content="CPMV" Grid.Row="6" VerticalAlignment="Bottom" Grid.Column="0" Margin="10,0,10,0"/>
                            <TextBox x:Name="tbCountryOptionsCPMV" Grid.Row="7" Grid.Column="0"  Margin="10,0,10,20"/>

                            <Label Content="Просмотры" Grid.Row="6" VerticalAlignment="Bottom" Grid.Column="1" Margin="10,0,10,0"/>
                            <TextBox x:Name="tbCountryOptionsProsmotr" Grid.Row="7" Grid.Column="1"  Margin="10,0,10,20"/>

                            <Label Content="Группы" Grid.Row="6" VerticalAlignment="Bottom" Grid.Column="2" Margin="10,0,10,0"/>
                            <ComboBox x:Name="cbCountryOptionsGroup" Grid.Row="7" Grid.Column="2"  Margin="10,0,10,20" IsEditable="True"  Text="Все">
                                <ComboBoxItem Content="Всё" />
                                <ComboBoxItem Content="Премиум" />
                                <ComboBoxItem Content="Медиум" />
                                <ComboBoxItem Content="Бомжи" />
                                <ComboBoxItem Content="Без бомжей" />
                                <ComboBoxItem Content="Без Медиума" />
                                <ComboBoxItem Content="Без премиума" />
                            </ComboBox>
                        </Grid>
                    </GroupBox>
                    <Button Grid.Row="3" Grid.Column="1" Content="Сохранить" Click="Button_Click" Margin="10" />
                    <Button Grid.Row="3" Grid.Column="0" Content="Удалить" Margin="10" Click="Button_Click_1" />
                </Grid>
            </TabItem>
            <TabItem Header="Настройки устройств">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>

                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="0.5*"/>
                    </Grid.RowDefinitions>
                    <ListBox x:Name="lbDeviceyOptyons" Margin="10" Grid.RowSpan="3" SelectionChanged="lbSrlectCountryOptions"/>
                    <GroupBox Header="Настройки" FontSize="20" Margin="10" Grid.Column="1" Grid.RowSpan="3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>

                            </Grid.RowDefinitions>
                            <Label Content="Название" Grid.Row="0" VerticalAlignment="Bottom" Grid.Column="1" Margin="10,0,10,0"/>
                            <TextBox x:Name="tbDeviceOptionsName" Grid.Row="1" Grid.Column="1"  Margin="10,0,10,20"/>

                           <Label Content="Увеличение" Grid.Row="2" VerticalAlignment="Bottom" Grid.Column="1" Margin="10,0,10,0"/>
                            <TextBox x:Name="tbDeviceOptionsUp" Grid.Row="3" Grid.Column="1"  Margin="10,0,10,20"/>

                            <Label Content="Уменьшение" Grid.Row="2" VerticalAlignment="Bottom" Grid.Column="2" Margin="10,0,10,0"/>
                            <TextBox x:Name="tbDeviceOptionsDown" Grid.Row="3" Grid.Column="2"  Margin="10,0,10,20"/>

                            <Label Content="Проц. дохода" Grid.Row="4" VerticalAlignment="Bottom" Grid.Column="0" Margin="10,0,10,0"/>
                            <TextBox x:Name="tbDeviceOptionsProc" Grid.Row="5" Grid.Column="0"  Margin="10,0,10,20"/>

                            <Label Content="Мин. Нули" Grid.Row="4" VerticalAlignment="Bottom" Grid.Column="1" Margin="10,0,10,0"/>
                            <TextBox x:Name="tbDeviceOptionsMin" Grid.Row="5" Grid.Column="1"  Margin="10,0,10,20"/>

                            <Label Content="Макс. Нули" Grid.Row="4" VerticalAlignment="Bottom" Grid.Column="2" Margin="10,0,10,0"/>
                            <TextBox x:Name="tbDeviceOptionsMax" Grid.Row="5" Grid.Column="2"  Margin="10,0,10,20"/>

                            <Label Content="CPMV" Grid.Row="2" VerticalAlignment="Bottom" Grid.Column="0" Margin="10,0,10,0"/>
                            <TextBox x:Name="tbDeviceOptionsCPMV" Grid.Row="3" Grid.Column="0"  Margin="10,0,10,20"/>

                            <Label Content="Просмотры" Grid.Row="6" VerticalAlignment="Bottom" Grid.Column="1" Margin="10,0,10,0"/>
                            <TextBox x:Name="tbDeviceOptionsProsmotr" Grid.Row="7" Grid.Column="1"  Margin="10,0,10,20"/>

                         
                        </Grid>
                    </GroupBox>
                    <Button Grid.Row="3" Grid.Column="1" Content="Сохранить" Click="Button_Click11" Margin="10" />
                    <Button Grid.Row="3" Grid.Column="0" Content="Удалить" Margin="10" Click="Button_Click_111" />
                </Grid>
            </TabItem>
            <TabItem Header="Рекламные компании">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>

                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="0.2*"/>
                        <RowDefinition Height="0.6*"/>
                        <RowDefinition Height="0.2*"/>
                    </Grid.RowDefinitions>
                    <ListBox x:Name="lbAdCompany" Margin="10" Grid.Row="1" Grid.RowSpan="2" SelectionChanged="lbAdCompany_SelectionChanged"/>
                    <Label Content="Номер компании" Grid.Row="0" Grid.Column="1" Margin="10,10,10,0"  VerticalAlignment="Bottom"  />
                    <TextBox  VerticalAlignment="Top" Padding="17" x:Name="tbAdCompanyId" TextWrapping="Wrap" Grid.Row="1" Grid.Column="1" Margin="10"   />
                    <Label Content="Название компании" Grid.Row="0" Grid.Column="2" Margin="10,10,10,0"  VerticalAlignment="Bottom"/>
                    <TextBox  VerticalAlignment="Top" Padding="17" x:Name="tbAdCompanyName" TextWrapping="Wrap" Grid.Row="1" Grid.Column="2" Margin="10"   />
                    <Label Content="Тип компании" Grid.Row="0" Grid.Column="3" Margin="10,10,10,0"  VerticalAlignment="Bottom"/>
                    <ComboBox  VerticalAlignment="Top" IsEditable="True" Padding="17" x:Name="cbAdCompanyType"  Grid.Row="1" Grid.Column="3" Margin="10"   >
                        <ComboBoxItem Content="Push"/>
                        <ComboBoxItem Content="Native"/>
                        <ComboBoxItem Content="Vitrina"/>
                    </ComboBox>
                    <Button  VerticalAlignment="Center" Content="Сохранить" Grid.Row="2" Grid.Column="3" Margin="10" Click="btnUserSaveClick"/>
                    <Button  VerticalAlignment="Center" Content="Удалить" Grid.Row="2" Grid.Column="2" Margin="10" Click="Button_Click_2"/>
                </Grid>
            </TabItem>
            <TabItem Header="Настройки потока">
                <Grid>
                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>
                    <Label Content="Рекламные компании" VerticalAlignment="Bottom"/>
                    <ComboBox Name="cbWhatAdCompanys" Grid.Row="1" Margin="10"/>
                    <Label Content="Настройки стран" Grid.Column="1" VerticalAlignment="Bottom"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="cbWhatCountryOptions" Margin="10"/>
                    <Label Content="Настройки устройств" Grid.Column="2" VerticalAlignment="Bottom"/>
                    <ComboBox Grid.Row="1" Grid.Column="2" x:Name="cbWhatDeviceOptions" Margin="10"/>

                    <CheckBox Content="Запрет прокси" Grid.Row="1" HorizontalAlignment="Center" Grid.Column="3" x:Name="cbProxy"/>
                    <Button Content="Сохранить" Grid.Column="3" Grid.Row="3" Margin="10" Click="btnSaveChangeOptionsAdCompany"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
