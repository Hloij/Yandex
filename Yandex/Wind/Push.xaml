<Window x:Class="Yandex.Wind.Push"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Yandex.Wind"
    
        Title="Push" Height="150" Width="350"  Loaded="Window_Loaded" Background="Black">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/> 
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <Button Content="Ок" Grid.Row="1" Grid.Column="4" Margin="10" Click="Button_Click"/>
        <TextBox Text="asdasd" TextWrapping="Wrap"  Grid.ColumnSpan="6" Grid.Row="0" Margin="10" FontSize="14" IsReadOnly="True" Name="tbText"/>
    </Grid>
</Window>
